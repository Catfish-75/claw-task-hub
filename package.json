{
  "name": "claw-task-hub",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "api": "tsx server/index.ts",
    "seed": "tsx server/seed.ts",
    "hub": "tsx server/hub-cli.ts",
    "migrate:linear": "tsx tools/linear-migration/migrate-linear.ts",
    "mcp": "tsx server/mcp-server.ts",
    "check:server": "tsc -p tsconfig.server.json --noEmit",
    "build": "tsc -b && npm run check:server && vite build",
    "lint": "eslint .",
    "store-regression": "tsx tests/store-regression.mjs",
    "harness-smoke": "node tests/harness-smoke.mjs",
    "ui-smoke": "playwright install chromium && node tests/ui-smoke.mjs",
    "public-hygiene": "node tests/public-hygiene.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.14.0",
    "nanoid": "^5.1.11",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "playwright": "^1.60.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
